function translateApiText(value: unknown): unknown {
  if (typeof value !== 'string' || locale === 'en') {
    return value;
  }

  return apiTranslations[locale]?.[value] ?? value;
}

function localizeSpec(input: unknown): unknown {
  const copy = JSON.parse(JSON.stringify(input));

  function visit(value: unknown): void {
    if (!value || typeof value !== 'object') return;

    const record = value as Record<string, unknown>;
    for (const key of ['title', 'summary', 'description']) {
      if (typeof record[key] === 'string') {
        record[key] = translateApiText(record[key]);
      }
    }

    Object.values(record).forEach(visit);
  }

  visit(copy);
  return copy;
}

const currentText = pageText[locale] ?? pageText.en;
const spec = localizeSpec(baseSpec);
---

<!doctype html>
<html lang={currentText.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="algolia-site-verification" content="958EE07D47EDCCC6" />
    <title>{currentText.title}</title>
    <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5/swagger-ui.css" />
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
      }

      body {
        margin: 0;
        background: #f7f8fa;
      }

      .api-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #dde2ea;
        background: #fff;
      }

      .api-header h1 {
        margin: 0;
        color: #111827;
        font-size: 1.125rem;
        font-weight: 650;
        letter-spacing: 0;
      }

      .api-header a {
        color: #2563eb;
        font-size: 0.875rem;
        text-decoration: none;
      }

      .api-header a:hover {
        text-decoration: underline;
      }

      #swagger-ui {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem;
      }

      .swagger-ui .topbar,
      .swagger-ui .models {
        display: none;
      }
    </style>
  </head>
  <body>
    <header class="api-header">
      <h1>{currentText.title}</h1>
      <a href={currentText.backHref}>{currentText.back}</a>
    </header>
    <main id="swagger-ui"></main>

    <script is:inline src="https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js"></script>
    <script is:inline src="https://unpkg.com/swagger-ui-dist@5/swagger-ui-standalone-preset.js"></script>
    <script is:inline define:vars={{ spec }}>
      window.addEventListener('load', () => {
        if (!window.SwaggerUIBundle) {
          document.querySelector('#swagger-ui').innerHTML =
            '<p style="padding:1rem;background:#fff;border:1px solid #dde2ea;border-radius:8px;color:#b91c1c;">Swagger UI failed to load. Check network access to unpkg.com.</p>';
          return;
        }

        window.ui = SwaggerUIBundle({
          spec,
          dom_id: '#swagger-ui',
          deepLinking: true,
          defaultModelsExpandDepth: -1,
          displayRequestDuration: true,
