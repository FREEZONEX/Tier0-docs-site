---
import spec from '../../public/openapi/tier0-cloud-v2.en.json';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="algolia-site-verification" content="958EE07D47EDCCC6" />
    <title>Tier0 OpenAPI Reference</title>
    <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5/swagger-ui.css" />
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
      }

      body {
        margin: 0;
        background: #f7f8fa;
      }

      .api-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #dde2ea;
        background: #fff;
      }

      .api-header h1 {
        margin: 0;
        color: #111827;
        font-size: 1.125rem;
        font-weight: 650;
        letter-spacing: 0;
      }

      .api-header a {
        color: #73b200;
        font-size: 0.875rem;
        text-decoration: none;
      }

      .api-header a:hover {
        text-decoration: underline;
      }

      .api-document {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem;
      }

      #swagger-ui {
        background: #fff;
      }

      :global(#swagger-ui .t0-reference-table) {
        margin: 1rem 0;
      }

      :global(#swagger-ui .t0-reference-table > summary) {
        padding: 0.875rem 1rem;
        color: #171717;
        font-size: 1rem;
        line-height: 1.5;
        font-weight: 700;
        cursor: pointer;
      }

      :global(#swagger-ui .t0-reference-table > summary:hover) {
        background: #f5f5f5;
      }

      :global(#swagger-ui .t0-reference-table > div) {
        overflow-x: auto;
      }

      :global(#swagger-ui .t0-reference-table table) {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
      }

      :global(#swagger-ui .t0-reference-table table :is(th, td)) {
        padding: 0.625rem 1rem;
        border: 1px solid #e1e1e1;
        text-align: left;
        vertical-align: top;
      }

      :global(#swagger-ui .t0-reference-table table th) {
        background: #f5f5f5;
      }

      #swagger-ui :global(.t0-response-tabs) {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0.75rem 0;
      }

      #swagger-ui :global(.t0-response-tab) {
        min-width: 3rem;
        border: 1px solid #cdd9bf;
        border-radius: 4px;
        padding: 0.3rem 0.55rem;
        background: #fff;
        color: #315b00;
        font: 700 0.75rem/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        cursor: pointer;
      }

      #swagger-ui :global(.t0-response-tab[aria-selected='true']) {
        border-color: #73b200;
        background: #e7f6be;
        color: #171717;
      }

      #swagger-ui :global(tr.t0-response-hidden) {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <header class="api-header">
      <h1>Tier0 OpenAPI Reference</h1>
      <a href="/using-tier0/working-with-factory-data/#api">Back to Working with Factory Data</a>
    </header>
    <main class="api-document">
      <div id="swagger-ui"></div>
    </main>

    <script is:inline src="https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js"></script>
    <script is:inline src="https://unpkg.com/swagger-ui-dist@5/swagger-ui-standalone-preset.js"></script>
    <script is:inline define:vars={{ spec }}>
      window.addEventListener('load', () => {
        if (!window.SwaggerUIBundle) {
          document.querySelector('#swagger-ui').innerHTML =
            '<p style="padding:1rem;background:#fff;border:1px solid #d8dfca;border-radius:8px;color:#7a1c1c;">The API reference could not load. Check network access to the renderer.</p>';
          return;
        }

        const addResponseTabs = () => {
          document.querySelectorAll('.responses-wrapper').forEach((wrapper) => {
            if (wrapper.dataset.t0ResponseTabs === 'ready') return;
            const rows = Array.from(wrapper.querySelectorAll('tbody tr.response'));
            if (rows.length < 2) return;

            const entries = rows
              .map((row) => ({
                row,
                status: row.querySelector('.response-col_status')?.textContent?.trim(),
              }))
              .filter((entry) => entry.status);
            if (entries.length < 2) return;

            const tabs = document.createElement('div');
            tabs.className = 't0-response-tabs';
            tabs.setAttribute('role', 'tablist');
            tabs.setAttribute('aria-label', 'Response status examples');

            const select = (selected) => {
              entries.forEach((entry) => {
                const active = entry === selected;
                entry.row.classList.toggle('t0-response-hidden', !active);
                entry.button.setAttribute('aria-selected', String(active));
              });
            };

            entries.forEach((entry, index) => {
              const button = document.createElement('button');
              button.type = 'button';
              button.className = 't0-response-tab';
              button.textContent = entry.status;
              button.setAttribute('role', 'tab');
              button.setAttribute('aria-selected', String(index === 0));
              button.addEventListener('click', () => select(entry));
              entry.button = button;
              tabs.append(button);
            });

            // Keep Swagger UI's "Responses" heading as the section label; the
            // status selector belongs to the response content that follows it.
            const responseHeading = wrapper.querySelector('.opblock-section-header');
            if (responseHeading) {
              responseHeading.after(tabs);
            } else {
              wrapper.prepend(tabs);
            }
            select(entries[0]);
            wrapper.dataset.t0ResponseTabs = 'ready';
          });
        };

        window.ui = SwaggerUIBundle({
          spec,
          dom_id: '#swagger-ui',
          deepLinking: true,
          defaultModelsExpandDepth: -1,
          defaultModelRendering: 'model',
          displayRequestDuration: true,
          presets: [SwaggerUIBundle.presets.apis, SwaggerUIStandalonePreset],
          layout: 'BaseLayout',
        });

        const tableLabels = new Map([
          ['HTTP status', 'HTTP Status Codes'],
          ['error.execution', 'Write Execution States'],
          ['Retry signal', 'Retry Rules'],
          ['Endpoint', 'Platform Response Formats'],
        ]);
        const updateReference = () => {
          document.querySelectorAll('#swagger-ui .info .description table').forEach((table) => {
            if (table.closest('.t0-reference-table')) return;
            const label = tableLabels.get(table.querySelector('thead th')?.textContent?.trim());
            if (!label) return;

            const details = document.createElement('details');
            details.className = 't0-reference-table';
            const summary = document.createElement('summary');
            summary.textContent = label;
            const content = document.createElement('div');
            table.before(details);
            details.append(summary, content);
            content.append(table);
          });
          addResponseTabs();
        };

        const referenceObserver = new MutationObserver(updateReference);
        referenceObserver.observe(document.querySelector('#swagger-ui'), { childList: true, subtree: true });
        updateReference();
      });
    </script>
  </body>
</html>
