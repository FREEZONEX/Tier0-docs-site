		function getLang() {
			const path = window.location.pathname.toLowerCase();
			if (path.startsWith('/zh-cn') || path.startsWith('/zh')) return 'zh';
			if (path.startsWith('/ja')) return 'ja';
			if (path.startsWith('/es')) return 'es';
			if (path.startsWith('/ko')) return 'ko';
			return 'en';
		}

		function getLocale(lang) {
			const locales = {
				en: 'en',
				zh: 'zh-CN',
				ja: 'ja',
				es: 'es',
				ko: 'ko',
			};
			return locales[lang] || 'en';
		}

		function getLanguageInstruction(lang) {
			const instructions = {
				en: 'Reply in English. Keep product names, commands, API paths, and code unchanged.',
				zh: '请使用简体中文回答。产品名称、命令、API 路径和代码请保持原样。',
				ja: '日本語で回答してください。製品名、コマンド、API パス、コードは原文のまま保持してください。',
				es: 'Responde en español. Mantén sin cambios los nombres de producto, comandos, rutas de API y código.',
				ko: '한국어로 답변하세요. 제품명, 명령어, API 경로 및 코드는 그대로 유지하세요.',
			};
			return instructions[lang] || instructions.en;
		}

		function getApiUrl(root) {
			const host = window.location.hostname;
			if (host === 'localhost' || host === '127.0.0.1') {
				return root.dataset.localApiUrl;
			}
			return root.dataset.prodApiUrl;
		}

		function escapeHtml(value) {
			return String(value || '')
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;')
				.replaceAll("'", '&#39;');
		}

		function safeHref(value) {
			const href = String(value || '').trim();
			if (/^(https?:\/\/|\/)/i.test(href)) return href;
			return '#';
		}

		function getInternalDocPath(value) {
			const href = String(value || '').trim();
			if (!href) return null;

			let pathname = '';
			try {
				pathname = new URL(href, window.location.origin).pathname;
			} catch (_) {
				return null;
			}

			const parts = pathname
				.replace(/^\/+|\/+$/g, '')
				.split('/')
				.filter(Boolean);
			if (['zh-cn', 'zh', 'ja', 'es', 'ko'].includes(parts[0])) parts.shift();
			const docPath = parts.join('/');
			return DOC_TITLES[docPath] ? docPath : null;
		}

		function localizeInternalHref(value, lang) {
			const href = String(value || '').trim();
			const docPath = getInternalDocPath(href);
			if (!docPath) return safeHref(href);

			let hash = '';
			try {
				hash = new URL(href, window.location.origin).hash;
			} catch (_) {
				hash = '';
			}

			const prefix = lang === 'en' ? '' : lang === 'zh' ? '/zh-cn' : '/' + lang;
			return prefix + '/' + docPath + '/' + hash;
		}

		function getReferenceTitle(ref, lang) {
			const docPath = getInternalDocPath(ref.url);
			if (!docPath) return ref.title || ref.url || 'Document';
			return DOC_TITLES[docPath][lang] || DOC_TITLES[docPath].en;
		}

		function renderInlineMarkdown(text) {
			let html = escapeHtml(text);
			html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function (_, label, href) {
				return (
					'<a href="' +
					escapeHtml(safeHref(href)) +
					'" target="_blank" rel="noreferrer">' +
					label +
					'</a>'
				);
			});
			html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
			html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
			return html;
		}

		function renderMarkdown(markdown) {
			const lines = String(markdown || '').split(/\r?\n/);
			const html = [];
			let listType = null;
			let paragraph = [];
			let inCode = false;
			let codeLines = [];

			function closeParagraph() {
				if (!paragraph.length) return;
				html.push('<p>' + renderInlineMarkdown(paragraph.join(' ')) + '</p>');
				paragraph = [];
			}

			function closeList() {
				if (!listType) return;
				html.push('</' + listType + '>');
				listType = null;
			}

			for (let i = 0; i < lines.length; i += 1) {
				const line = lines[i];
				if (/^```/.test(line.trim())) {
					if (inCode) {
						html.push('<pre><code>' + escapeHtml(codeLines.join('\n')) + '</code></pre>');
						codeLines = [];
						inCode = false;
					} else {
						closeParagraph();
						closeList();
						inCode = true;
					}
					continue;
				}

				if (inCode) {
					codeLines.push(line);
					continue;
				}

				const trimmed = line.trim();
				if (!trimmed) {
					closeParagraph();
					const nextListLine = lines
						.slice(i + 1)
						.find(function (nextLine) {
							return nextLine.trim();
						});
					if (
						listType &&
						nextListLine &&
						((listType === 'ol' && /^\d+\.\s+/.test(nextListLine.trim())) ||
							(listType === 'ul' && /^[-*]\s+/.test(nextListLine.trim())))
					) {
						continue;
					}
					closeList();
					continue;
				}

				const heading = /^(#{1,3})\s+(.+)$/.exec(trimmed);
				if (heading) {
					closeParagraph();
					closeList();
					html.push('<h' + heading[1].length + '>' + renderInlineMarkdown(heading[2]) + '</h' + heading[1].length + '>');
					continue;
				}

				const unordered = /^[-*]\s+(.+)$/.exec(trimmed);
				const ordered = /^\d+\.\s+(.+)$/.exec(trimmed);
				if (unordered || ordered) {
					const nextType = unordered ? 'ul' : 'ol';
					closeParagraph();
					if (listType !== nextType) {
						closeList();
						html.push('<' + nextType + '>');
						listType = nextType;
					}
					html.push('<li>' + renderInlineMarkdown((unordered || ordered)[1]) + '</li>');
					continue;
				}

				closeList();
				paragraph.push(trimmed);
			}

			if (inCode) html.push('<pre><code>' + escapeHtml(codeLines.join('\n')) + '</code></pre>');
			closeParagraph();
			closeList();
			return html.join('');
		}

		function initDocChatBot() {
			document.querySelectorAll('[data-doc-chatbot]').forEach(function (root) {
				if (root.dataset.bound === '1') return;
				root.dataset.bound = '1';

				let lang = getLang();
				let texts = TEXTS[lang];
				let apiUrl = getApiUrl(root);
				let open = false;
				let loading = false;
				let input = '';
				let messages = [
					{
						role: 'assistant',
						content: texts.welcome,
						references: [],
						suggestedQuestions: texts.suggestedQuestions,
					},
				];

				const panel = root.querySelector('[data-doc-chatbot-panel]');
				const toggle = root.querySelector('[data-doc-chatbot-toggle]');
				const close = root.querySelector('[data-doc-chatbot-close]');
				const icon = root.querySelector('[data-doc-chatbot-icon]');
				const entryClose = root.querySelector('[data-doc-chatbot-entry-close]');
				const tip = root.querySelector('[data-doc-chatbot-tip]');
				const title = root.querySelector('[data-doc-chatbot-title]');
				const subtitle = root.querySelector('[data-doc-chatbot-subtitle]');
				const messagesEl = root.querySelector('[data-doc-chatbot-messages]');
				const inputEl = root.querySelector('[data-doc-chatbot-input]');
				const sendButton = root.querySelector('[data-doc-chatbot-send]');

				function syncLocale() {
					const nextLang = getLang();
					if (nextLang === lang) return;
					lang = nextLang;
					texts = TEXTS[lang];
					apiUrl = getApiUrl(root);
					messages = [
						{
							role: 'assistant',
							content: texts.welcome,
							references: [],
							suggestedQuestions: texts.suggestedQuestions,
						},
					];
				}

				function render() {
					tip.textContent = texts.entryTip;
					tip.hidden = open;
					title.textContent = texts.title;
					subtitle.textContent = texts.subtitle;
					inputEl.placeholder = texts.placeholder;
					sendButton.textContent = texts.send;
					sendButton.disabled = loading || !input.trim();
					panel.hidden = !open;
					toggle.classList.toggle('doc-chatbot-button-open', open);
					toggle.setAttribute('aria-label', open ? texts.closeLabel : texts.openLabel);
					icon.hidden = open;
					entryClose.hidden = !open;

					const lastMessage = messages[messages.length - 1];
					const suggestedQuestions =
						lastMessage?.role === 'assistant' && lastMessage?.suggestedQuestions?.length
							? lastMessage.suggestedQuestions
							: texts.suggestedQuestions;
					const shouldShowSuggestions =
						!loading &&
						messages.length > 0 &&
						lastMessage.role === 'assistant' &&
						suggestedQuestions.length > 0;

					messagesEl.innerHTML = messages
						.map(function (message) {
							const refs = Array.isArray(message.references) ? message.references : [];
							const refsHtml = refs.length
								? '<div class="doc-chatbot-references"><div class="doc-chatbot-references-title">' +
									escapeHtml(texts.references) +
									'</div><ul>' +
									refs
										.map(function (ref) {
											const internalDocPath = getInternalDocPath(ref.url);
											const title = escapeHtml(getReferenceTitle(ref, lang));
											const href = localizeInternalHref(ref.url, lang);
											const section = ref.section && !internalDocPath
												? ' <span class="doc-chatbot-section">/ ' + escapeHtml(ref.section) + '</span>'
												: '';
											return (
												'<li><a href="' +
												escapeHtml(href) +
												'" target="_blank" rel="noreferrer">' +
												title +
												'</a>' +
												section +
												'</li>'
											);
										})
										.join('') +
									'</ul></div>'
								: '';
							return (
								'<div class="doc-chatbot-message doc-chatbot-message-' +
								escapeHtml(message.role) +
								'"><div class="doc-chatbot-bubble">' +
								renderMarkdown(message.content) +
								refsHtml +
								'</div></div>'
							);
						})
						.join('');

					if (loading) {
						messagesEl.insertAdjacentHTML(
							'beforeend',
							'<div class="doc-chatbot-message doc-chatbot-message-assistant"><div class="doc-chatbot-bubble">' +
								escapeHtml(texts.thinking) +
								'</div></div>',
						);
					}

					if (shouldShowSuggestions) {
						const suggestions = document.createElement('div');
						suggestions.className = 'doc-chatbot-suggestions';
						suggestions.innerHTML =
							'<div class="doc-chatbot-suggestions-title">' +
							escapeHtml(texts.suggestedTitle) +
							'</div><div class="doc-chatbot-suggestions-list"></div>';
						const list = suggestions.querySelector('.doc-chatbot-suggestions-list');
						suggestedQuestions.forEach(function (question) {
							const button = document.createElement('button');
							button.className = 'doc-chatbot-suggestion';
							button.type = 'button';
							button.textContent = question;
							button.disabled = loading;
							button.addEventListener('click', function () {
								sendMessage(question);
							});
							list.appendChild(button);
						});
						messagesEl.appendChild(suggestions);
					}

					if (open) messagesEl.scrollTop = messagesEl.scrollHeight;
				}

				async function sendMessage(overrideText) {
					const text = String(overrideText || inputEl.value || '').trim();
					if (!text || loading) return;

					input = '';
					inputEl.value = '';
					messages.push({
						role: 'user',
						content: text,
						references: [],
						suggestedQuestions: [],
					});
					loading = true;
					render();

					try {
						const locale = getLocale(lang);
						const messageWithLocale =
							getLanguageInstruction(lang) +
							'\n\nCurrent documentation page: ' +
							window.location.href +
							'\n\nUser question:\n' +
							text;
						const response = await fetch(apiUrl, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								message: messageWithLocale,
								originalMessage: text,
								lang,
								locale,
								language: locale,
								pageUrl: window.location.href,
								pathname: window.location.pathname,
							}),
						});
						if (!response.ok) throw new Error('Request failed: ' + response.status);

						const data = await response.json();
						messages.push({
							role: 'assistant',
							content: data.answer || texts.noAnswer,
							references: Array.isArray(data.references) ? data.references : [],
							suggestedQuestions: texts.suggestedQuestions,
						});
					} catch (_) {
						messages.push({
							role: 'assistant',
							content: texts.unavailable,
							references: [],
							suggestedQuestions: texts.suggestedQuestions,
						});
					} finally {
						loading = false;
						render();
					}
				}

				toggle.addEventListener('click', function () {
					syncLocale();
					open = !open;
					render();
					if (open) inputEl.focus();
				});
				close.addEventListener('click', function () {
					open = false;
					render();
				});
				inputEl.addEventListener('input', function () {
					input = inputEl.value;
					sendButton.disabled = loading || !input.trim();
				});
				inputEl.addEventListener('keydown', function (event) {
					if (event.key === 'Enter' && !event.shiftKey) {
						event.preventDefault();
						sendMessage();
					}
				});
				sendButton.addEventListener('click', function () {
					sendMessage();
				});

				render();
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initDocChatBot);
		} else {
			initDocChatBot();
		}
		document.addEventListener('astro:page-load', initDocChatBot);
	})();
</script>

