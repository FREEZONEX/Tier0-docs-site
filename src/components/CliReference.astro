      'CLI는 엄격한 최대 파일 크기를 강제하지 않으며, 서버가 플랜/할당량 제한을 적용합니다.',
    'Business scene': '비즈니스 장면',
    'Usage scope: user|workspace|platform':
      '사용 범위: user|workspace|platform',
    'Visibility: public|private': '가시성: public|private',
    'AI app instance ID': 'AI 앱 인스턴스 ID',
    'AI session ID': 'AI 세션 ID',
    'Multipart part size (e.g. 10MB, min 5MB)':
      '멀티파트 파트 크기(예: 10MB, 최소 5MB)',
    'Multipart upload concurrency (number of parallel parts)':
      '멀티파트 업로드 동시성(병렬 파트 수)',
    'Resume an interrupted multipart upload': '중단된 멀티파트 업로드 재개',
    'Abort an interrupted multipart upload and clean up its state':
      '중단된 멀티파트 업로드를 중단하고 상태 정리',
    'File path returned by upload': '업로드에서 반환된 파일 경로',
    'Output file path (default: stdout)': '출력 파일 경로(기본값: stdout)',
    'Custom Content-Disposition': '사용자 지정 Content-Disposition',
    'Presigned URL expiration seconds': '사전 서명 URL 만료 시간(초)',
  },
};

function translateCliText(value: string): string {
  const translations =
    cliTextTranslations[locale] ?? {};
  const supplemental =
    supplementalCliTextTranslations[locale] ?? {};

  return supplemental[value] ?? translations[value] ?? value;
}

function noteInlineParts(value: string) {
  const parts: Array<{
    type: 'text' | 'code';
    value: string;
  }> = [];
  const tokenPattern =
    /`([^`]+)`|(--[a-z0-9][a-z0-9-]*)|(\b[a-z][a-z0-9]+(?:_[a-z0-9]+)+\b)/gi;
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  while ((match = tokenPattern.exec(value))) {
    if (match.index > lastIndex) {
      parts.push({
        type: 'text',
        value: value.slice(lastIndex, match.index),
      });
    }

    parts.push({
      type: 'code',
      value: match[1] ?? match[2] ?? match[3],
    });
    lastIndex =
      match.index + match[0].length;
  }

  if (lastIndex < value.length) {
    parts.push({
      type: 'text',
      value: value.slice(lastIndex),
    });
  }

  return parts;
}

function flagName(flag: CliFlag): string {
  if (flag.shorthand) {
    return `${flag.shorthand}, ${flag.name}`;
  }

  return flag.name;
}

function formatDefault(flag: CliFlag): string | null {
  if (
    flag.default === null ||
    flag.default === undefined ||
    flag.default === ''
  ) {
    return null;
  }

  if (
    flag.type === 'bool' &&
    flag.default === false
  ) {
    return null;
  }

  return String(flag.default);
}

function commandSearchText(
  command: CliCommand
): string {
  return [
    command.command,
    translateCliText(command.description),
    ...(command.usage ?? []),
    ...(command.aliases ?? []),
    ...(command.examples ?? []),
    ...(command.notes ?? []).map((note) =>
      translateCliText(note)
    ),
    ...(command.flags ?? []).flatMap(
      (flag: CliFlag) => [
        flag.name,
        flag.shorthand ?? '',
        translateCliText(
          flag.description ?? ''
        ),
      ]
    ),
  ]
    .join(' ')
    .toLowerCase();
}
---

<div class="cli-reference not-content">
  <div class="cli-intro">
    <div class="cli-search-wrap">
      <input
        id="cli-search"
        class="cli-search"
        type="search"
        placeholder={text.searchPlaceholder}
        autocomplete="off"
      />

      <span
        id="cli-result-count"
        class="cli-result-count"
      ></span>
    </div>

    {
      data.globalFlags.length > 0 && (
        <div class="global-flags">
          <div class="global-flags-heading">
            <span class="global-flags-label">
              {text.globalFlags}
            </span>
            <span class="global-flags-hint">
              {text.globalFlagsHintBefore}{' '}
              <code>tier0</code>{' '}
              {text.globalFlagsHintAfter}
            </span>
          </div>

          <div class="global-flags-list">
            {
              data.globalFlags.map(
                (flag: CliFlag) => (
                  <span class="global-flag">
                    <code>{flag.name}</code>
                    <span>
                      {translateCliText(
                        flag.description
                      )}
                    </span>
                  </span>
                )
              )
            }
          </div>
        </div>
      )
    }
  </div>

  <div id="cli-groups">
    {
      data.groups.map(
        (group: CliGroup) => (
          <section class="cli-group">
            <h2>{translateCliText(group.name)}</h2>

            <div class="cli-command-list">
              {
                group.commands.map(
                  (command: CliCommand) => (
                    <details
                      class="cli-item"
                      data-search={commandSearchText(
                        command
                      )}
                    >
                      <summary>
                        <code class="cli-command">
                          {command.command}
                        </code>

                        <span class="cli-description">
                          {translateCliText(
                            command.description
                          )}
                        </span>

                        {
                          command.aliases.length >
                            0 && (
                            <span class="cli-alias">
                              {text.alias}:{' '}
                              {command.aliases.join(
                                ', '
                              )}
                            </span>
                          )
                        }
                      </summary>

                      <div class="cli-content">
                        {
                          command.usage.length >
                            0 && (
                            <section class="cli-detail">
                              <h4>{text.usage}</h4>

                              <div class="cli-code-list">
                                {
                                  command.usage.map(
                                    (
                                      usage: string
                                    ) => (
                                      <Code
                                        code={usage}
                                        lang="bash"
                                      />
                                    )
                                  )
                                }
                              </div>
                            </section>
                          )
                        }

                        {
                          command.flags.filter(
                            (
                              flag: CliFlag
                            ) => !flag.hidden
                          ).length > 0 && (
                            <section class="cli-detail cli-flags">
                              <h4>{text.flags}</h4>

                              <dl>
                                {
                                  command.flags
                                    .filter(
                                      (
                                        flag: CliFlag
                                      ) =>
                                        !flag.hidden
                                    )
                                    .map(
                                      (
                                        flag: CliFlag
                                      ) => {
                                        const defaultValue =
                                          formatDefault(
                                            flag
                                          );

                                        return (
                                          <div class="cli-flag-row">
                                            <dt>
                                              <code>
                                                {flagName(
                                                  flag
                                                )}
                                              </code>
                                            </dt>

                                            <dd>
                                              <span class="flag-description">
                                                {
                                                  translateCliText(
                                                    flag.description
                                                  )
                                                }
                                              </span>

                                              <span class="flag-meta">
                                                {
                                                  flag.required && (
                                                    <span class="flag-required">
                                                      {text.required}
                                                    </span>
                                                  )
                                                }

                                                {
                                                  flag.repeatable && (
                                                    <span>
                                                      {text.repeatable}
                                                    </span>
                                                  )
                                                }

                                                {
                                                  flag.deprecated && (
                                                    <span class="flag-deprecated">
                                                      {text.deprecated}
                                                    </span>
                                                  )
                                                }

                                                {
                                                  defaultValue !==
                                                    null && (
                                                    <span>
                                                      {text.defaultValue}:{' '}
                                                      <code>
                                                        {
                                                          defaultValue
                                                        }
                                                      </code>
                                                    </span>
                                                  )
                                                }
                                              </span>
                                            </dd>
                                          </div>
                                        );
                                      }
                                    )
                                }
                              </dl>
                            </section>
                          )
                        }

                        {
                          command.notes.length >
                            0 && (
                            <section class="cli-detail cli-notes">
                              <h4>{text.notes}</h4>

                              <ul>
                                {
                                  command.notes.map(
                                    (
                                      note: string
                                    ) => (
                                      <li>
                                        {
                                          noteInlineParts(
                                            translateCliText(
                                              note
                                            )
                                          ).map(
                                            (part) =>
                                              part.type ===
                                              'code' ? (
                                                <code>
                                                  {
                                                    part.value
                                                  }
                                                </code>
                                              ) : (
                                                part.value
                                              )
                                          )
                                        }
                                      </li>
                                    )
                                  )
                                }
                              </ul>
                            </section>
                          )
                        }

                        {
                          command.examples.length >
                            0 && (
                            <section class="cli-detail">
                              <h4>
                                {
                                  command.examples
                                    .length > 1
                                    ? text.examples
                                    : text.example
                                }
                              </h4>

                              <div class="cli-code-list">
                                {
                                  command.examples.map(
                                    (
                                      example: string
                                    ) => (
                                      <Code
                                        code={example}
                                        lang="bash"
                                      />
                                    )
                                  )
                                }
                              </div>
                            </section>
                          )
                        }
                      </div>
                    </details>
                  )
                )
              }
            </div>
          </section>
        )
      )
    }
  </div>

  <div
    id="cli-empty"
    class="cli-empty"
    hidden
  >
    {text.empty}
  </div>
</div>

<script define:vars={{ countLabels: {
  commands: text.commands,
  of: text.of,
} }}>
  const searchInput =
    document.querySelector<HTMLInputElement>(
      '#cli-search'
    );

  const resultCount =
    document.querySelector<HTMLSpanElement>(
      '#cli-result-count'
    );

  const emptyState =
    document.querySelector<HTMLDivElement>(
      '#cli-empty'
    );

  const commandItems =
    Array.from(
      document.querySelectorAll<HTMLDetailsElement>(
        '.cli-item'
      )
    );

  const groups =
    Array.from(
      document.querySelectorAll<HTMLElement>(
        '.cli-group'
      )
    );

  function updateCount(): void {
    const visible =
      commandItems.filter(
        (
          item: HTMLDetailsElement
        ) => !item.hidden
      ).length;

    const total =
      commandItems.length;

    if (resultCount) {
      resultCount.textContent =
        visible === total
          ? `${total} ${countLabels.commands}`
          : `${visible} ${countLabels.of} ${total} ${countLabels.commands}`;
    }

    if (emptyState) {
      emptyState.hidden =
        visible !== 0;
    }
  }

  function filterCommands(
    query: string
  ): void {
    const normalized =
      query
        .trim()
        .toLowerCase();

    commandItems.forEach(
      (
        item: HTMLDetailsElement
      ) => {
        const searchText =
          item.dataset.search ?? '';

        item.hidden =
          normalized !== '' &&
          !searchText.includes(
            normalized
          );
      }
    );

    groups.forEach(
      (group: HTMLElement) => {
        const visibleCommands =
          group.querySelectorAll(
            '.cli-item:not([hidden])'
          );

        group.hidden =
          visibleCommands.length === 0;
      }
    );

    updateCount();
  }

  searchInput?.addEventListener(
    'input',
    (
      event: Event
    ) => {
      const target =
        event.currentTarget as HTMLInputElement;

      filterCommands(
        target.value
      );
    }
  );

  updateCount();
</script>

