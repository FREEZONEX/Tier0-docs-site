import { Code } from '@astrojs/starlight/components';
import cliReferenceData from '../../public/openapi/tier0-cli-reference.json';

type CliFlag = {
  name: string;
  shorthand?: string | null;
  type: string;
  required: boolean;
  repeatable: boolean;
  default: string | number | boolean | null;
  description: string;
  deprecated?: boolean;
  hidden?: boolean;
};

type CliCommand = {
  command: string;
  cobraUse: string;
  description: string;
  usage: string[];
  aliases: string[];
  flags: CliFlag[];
  examples: string[];
  notes: string[];
};

type CliGroup = {
  id: string;
  name: string;
  commands: CliCommand[];
};

type CliReferenceData = {
  schemaVersion: string;
  title: string;
  sourceOfTruth: {
    cliRepository: string;
    cliBranch: string;
    commandMetadata: string;
    skillRepository: string;
    skillRole: string;
  };
  globalFlags: CliFlag[];
  groups: CliGroup[];
};

const data =
  cliReferenceData as CliReferenceData;

const locale =
  Astro.url.pathname.split('/')[1] ?? '';

